# Dashboard database settings
PROJECT_E_DB_HOST=127.0.0.1
PROJECT_E_DB_PORT=5432
PROJECT_E_DB_NAME=postgres
PROJECT_E_DB_USER=n8n
PROJECT_E_DB_PASSWORD=CHANGE_ME

# Dashboard mode: "database" is the normal default. "demo" uses only the
# fictional, repository-local fixtures under examples/ and never opens a DB connection.
PROJECT_E_DASHBOARD_MODE=database

# Deployment tool. Never commit the real value.
PROJECT_E_N8N_API_KEY=CHANGE_ME

# Representative workflow settings to configure in your own n8n instance.
PROJECT_E_EMBEDDING_URL=https://embedding.example.invalid/v1/embeddings
PROJECT_E_EMBEDDING_MODEL=CONFIGURE_EMBEDDING_MODEL
PROJECT_E_QDRANT_URL=https://qdrant.example.invalid
PROJECT_E_QDRANT_COLLECTION=project_e_demo_knowledge_base
PROJECT_E_CHAT_MODEL=CONFIGURE_CHAT_MODEL
